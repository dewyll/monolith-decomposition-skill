{
  "schema_version": 1,
  "project_root": "..",
  "languages": [
    "python"
  ],
  "source_roots": [
    "."
  ],
  "include": [
    "**/*"
  ],
  "exclude": [
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/spec/**",
    "**/testing/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_test.go",
    "**/test_*.py",
    "**/*_test.py",
    "**/*Test.java",
    "**/*Tests.java",
    "**/*Test.kt",
    "**/*Tests.cs",
    "**/*Test.php",
    "**/vendor/**",
    "**/dist/**",
    "**/build/**",
    "**/target/**",
    "**/out/**",
    "**/bin/**",
    "**/obj/**",
    "**/generated/**",
    "**/*.generated.*",
    "**/*.min.js",
    "**/migrations/**"
  ],
  "extensions": [],
  "import_aliases": {},
  "components": {
    "strategy": "directory",
    "max_depth": null,
    "separator": ".",
    "explicit": []
  },
  "metrics": {
    "size": "auto"
  },
  "thresholds": {
    "size_outlier_stddev": 1.0,
    "max_component_percent": 15.0,
    "max_efferent_coupling": null,
    "min_domain_cohesion": null,
    "common_fan_in_ratio": 0.3
  },
  "common_keywords": [
    "audit",
    "auditing",
    "log",
    "logging",
    "logger",
    "notification",
    "notifications",
    "notify",
    "email",
    "mail",
    "mailer",
    "sms",
    "util",
    "utils",
    "utility",
    "common",
    "shared",
    "helper",
    "helpers",
    "validation",
    "validator",
    "formatter",
    "security",
    "auth",
    "config",
    "cache",
    "messaging",
    "events",
    "i18n",
    "pdf",
    "report",
    "reporting"
  ],
  "fitness": {
    "size_allowlist": {
      "shopco.orders": "RFC-0002: split by the Phase 3 push-down (RFC-0004); remove this entry when it lands"
    },
    "orphan_allowlist": {
      "shopco": "RFC-0004: entry point and composition root, stays in the root on purpose",
      "shopco.orders": "RFC-0004: push-down to shopco.orders.core scheduled with the ordering-service extraction; remove when done"
    },
    "allowed_cycles": [],
    "forbidden_dependencies": [
      {
        "from": "platform",
        "to": "*",
        "level": "domain",
        "rfc": "0006"
      },
      {
        "from": "customer",
        "to": "*",
        "level": "domain",
        "rfc": "0006"
      },
      {
        "from": "ordering",
        "to": "reporting",
        "level": "domain",
        "rfc": "0006"
      },
      {
        "from": "payment",
        "to": "reporting",
        "level": "domain",
        "rfc": "0006"
      },
      {
        "from": "payment",
        "to": "ordering",
        "level": "domain",
        "rfc": "0006"
      }
    ]
  },
  "workspace": {
    "rfc_dir": "rfcs"
  }
}
